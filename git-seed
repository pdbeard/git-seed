#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.0"

# Associative arrays and 'local -n' namerefs need bash 4.3+. macOS ships
# bash 3.2 as /bin/bash, where those fail with unrelated-looking errors.
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3) )); then
    echo "[ERROR] git-seed requires bash 4.3+ (found ${BASH_VERSION})" >&2
    echo "        On macOS: brew install bash" >&2
    exit 1
fi

# ── Config ────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
XDG_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/git-seed/repos.conf"

if [[ -n "${CONF_FILE:-}" ]]; then
    CONF="$CONF_FILE"
elif [[ -f "$XDG_CONF" ]]; then
    CONF="$XDG_CONF"
else
    CONF="$SCRIPT_DIR/repos.conf"
fi

BASE_DIR="${BASE_DIR:-$HOME/git-seed-repos}"
DRY_RUN=false
CLONE_ONLY=false
PULL_ONLY=false
RECENT_MINE=false
LIST_DIR="projects"
SYNC_ERRORS=0

# ── Auth ──────────────────────────────────────────────────────────
# Sets GIT_AUTH to the git options that supply the token, or leaves it empty.
# Call it directly, never in $(...), or the assignment is lost. Expand with
# ${GIT_AUTH[@]+"${GIT_AUTH[@]}"}: bash 4.3 treats an empty array as unset.
# The helper is scoped to github.com so the token is never offered to a
# remote on another host.
GIT_AUTH=()

load_auth() {
    local token="${GITHUB_TOKEN:-}"
    if [[ -z "$token" ]] && command -v gh &>/dev/null; then
        token="$(gh auth token 2>/dev/null || true)"
    fi
    [[ -z "$token" ]] && return 0
    GIT_AUTH=(-c "credential.https://github.com.helper=!f() { echo username=x-access-token; echo password=$token; }; f")
}

# ── Parse conf ────────────────────────────────────────────────────
# Strips the comment and trailing whitespace from the named variable, so a
# blank or comment-only line becomes empty. An annotation must never become
# part of a path or a repo name; '#' is not valid in either, so cutting at
# the first one is unambiguous.
strip_conf_line() {
    local -n _l="$1"
    _l="${_l%%#*}"
    _l="${_l%"${_l##*[![:space:]]}"}"
}


# Calls: callback base_dir dir owner/repo
# Handles [path] sections, skips comments and blank lines,
# warns on malformed entries. Entries above any [path] section
# use BASE_DIR as fallback.
parse_conf() {
    local callback="$1"
    local current_base="$BASE_DIR"

    if [[ ! -f "$CONF" ]]; then
        echo "[ERROR] Config file not found: $CONF" >&2
        exit 1
    fi

    while IFS= read -r line; do
        strip_conf_line line
        [[ -z "$line" ]] && continue

        if [[ "$line" =~ ^\[path[[:space:]]+(.+)\]$ ]]; then
            current_base="${BASH_REMATCH[1]/#\~/$HOME}"
            continue
        fi

        local dir repo extra
        read -r dir repo extra <<< "$line"
        # Strip any run of trailing whitespace and slashes.
        repo="${repo%"${repo##*[![:space:]/]}"}"
        [[ -z "$dir" || -z "$repo" ]] && continue

        if [[ -n "$extra" ]]; then
            echo "[WARN]  Ignoring extra fields after '$repo' in: $line" >&2
        fi

        if [[ "$repo" != */* ]]; then
            echo "[WARN]  Skipping malformed entry: $line" >&2
            continue
        fi

        "$callback" "$current_base" "$dir" "$repo" || true
    done < "$CONF"
}

# ── Collect unique [path] entries from conf ───────────────────────
# Only includes BASE_DIR if there are entries above any [path] section.
get_conf_paths() {
    local -n _out="$1"

    [[ ! -f "$CONF" ]] && _out["$BASE_DIR"]=1 && return

    local seen_path_section=false
    local has_pre_section_entries=false

    while IFS= read -r line; do
        strip_conf_line line
        [[ -z "$line" ]] && continue

        if [[ "$line" =~ ^\[path[[:space:]]+(.+)\]$ ]]; then
            seen_path_section=true
            local p="${BASH_REMATCH[1]/#\~/$HOME}"
            _out["$p"]=1
        elif [[ "$seen_path_section" == false ]]; then
            has_pre_section_entries=true
        fi
    done < "$CONF"

    if [[ "$seen_path_section" == false || "$has_pre_section_entries" == true ]]; then
        _out["$BASE_DIR"]=1
    fi
}

# ── Sync callback (clone missing, pull existing) ──────────────────
do_sync() {
    local base_dir="$1" dir="$2" repo="$3"
    local dest
    dest="$base_dir/$dir/$(basename "$repo")"

    if [[ -e "$dest" ]] && ! is_empty_dir "$dest"; then
        # Never clone into or over an occupied path that is not a clone;
        # whatever is there belongs to the user.
        if ! is_git_repo "$dest"; then
            echo "[ERROR] $repo: path exists but is not a git repo: $dest"
            SYNC_ERRORS=$((SYNC_ERRORS + 1))
            return 1
        fi
        if [[ "$CLONE_ONLY" == true ]]; then
            echo "[SKIP]  $repo (already exists)"
            return
        fi
        if ! git -C "$dest" symbolic-ref HEAD &>/dev/null; then
            echo "[SKIP]  $repo (detached HEAD — checkout a branch to pull)"
            return
        fi
        if ! git -C "$dest" rev-parse --abbrev-ref '@{upstream}' &>/dev/null; then
            echo "[SKIP]  $repo (no upstream — nothing to pull from)"
            return
        fi
        if [[ "$DRY_RUN" == true ]]; then
            echo "[DRY]   would pull $repo"
        else
            echo "[PULL]  $repo"
            # Fast-forward only: a diverged branch fails cleanly instead of
            # being left mid-merge partway through a bulk sync.
            git -C "$dest" ${GIT_AUTH[@]+"${GIT_AUTH[@]}"} pull --ff-only || {
                echo "[ERROR] Failed to pull $repo"
                SYNC_ERRORS=$((SYNC_ERRORS + 1))
                return 1
            }
        fi
        return
    fi

    if [[ "$PULL_ONLY" == true ]]; then
        echo "[SKIP]  $repo (not cloned)"
        return
    fi

    if [[ "$DRY_RUN" == true ]]; then
        echo "[DRY]   would clone $repo → $dest"
        return
    fi

    mkdir -p "$base_dir/$dir"
    echo "[CLONE] $repo → $dest"
    git ${GIT_AUTH[@]+"${GIT_AUTH[@]}"} clone "https://github.com/${repo}.git" "$dest" || {
        echo "[ERROR] Failed to clone $repo"
        SYNC_ERRORS=$((SYNC_ERRORS + 1))
        return 1
    }
}

# Shared tail for --sync / --clone-only / --pull-only.
# Exits non-zero when any repo failed, so scripts and cron can tell.
run_sync() {
    [[ "$DRY_RUN" == false ]] && load_auth
    parse_conf do_sync
    echo ""
    if [[ "$SYNC_ERRORS" -gt 0 ]]; then
        echo "[WARN]  $SYNC_ERRORS repo(s) failed to sync"
    fi
    if [[ "$DRY_RUN" == false ]]; then
        echo "[HINT] Try: git-seed --browse"
    fi
    (( SYNC_ERRORS == 0 ))
}

# ── Status callback ───────────────────────────────────────────────
# States are mutually exclusive, evaluated in this order:
#   MISSING  no clone (path absent, or present but empty)
#   BROKEN   path occupied by something that is not a git repo
#   DIRTY    uncommitted changes in the working tree
#   AHEAD    tree clean, but commits are not yet on the upstream
#   OK       cloned, clean, nothing unpushed
# Unpushed commits are reported for DIRTY repos too, in the detail column,
# so the count is never hidden by the more urgent state.
STATUS_CLONED=0
STATUS_MISSING=0
STATUS_BROKEN=0
STATUS_DIRTY=0
STATUS_AHEAD=0

# Builds the trailing detail string for a cloned repo, e.g.
# "3 changes, 2 unpushed" or "no upstream". Empty when there is nothing to say.
status_detail() {
    local -a parts=()

    if (( REPO_CHANGES == 1 )); then
        parts+=("1 change")
    elif (( REPO_CHANGES > 1 )); then
        parts+=("$REPO_CHANGES changes")
    fi

    if (( REPO_AHEAD > 0 )); then
        parts+=("$REPO_AHEAD unpushed")
    fi

    if [[ "$REPO_UPSTREAM" == false ]]; then
        parts+=("no upstream")
    fi

    local out="" part
    for part in "${parts[@]:-}"; do
        [[ -z "$part" ]] && continue
        [[ -n "$out" ]] && out+=", "
        out+="$part"
    done
    printf "%s" "$out"
}

do_status() {
    local base_dir="$1" dir="$2" repo="$3"
    local dest
    dest="$base_dir/$dir/$(basename "$repo")"

    if [[ ! -e "$dest" ]] || is_empty_dir "$dest"; then
        printf "%-10s%s\n" "[MISSING]" "$repo"
        STATUS_MISSING=$((STATUS_MISSING + 1))
        return
    fi

    if ! is_git_repo "$dest"; then
        printf "%-10s%-32s%s\n" "[BROKEN]" "$repo" "not a git repo: $dest"
        STATUS_BROKEN=$((STATUS_BROKEN + 1))
        return
    fi

    STATUS_CLONED=$((STATUS_CLONED + 1))
    inspect_repo "$dest"

    local state detail
    detail="$(status_detail)"
    if (( REPO_CHANGES > 0 )); then
        state="[DIRTY]"
        STATUS_DIRTY=$((STATUS_DIRTY + 1))
    elif (( REPO_AHEAD > 0 )); then
        state="[AHEAD]"
        STATUS_AHEAD=$((STATUS_AHEAD + 1))
    else
        state="[OK]"
    fi

    if [[ -n "$detail" ]]; then
        printf "%-10s%-32s%s\n" "$state" "$repo" "$detail"
    else
        printf "%-10s%s\n" "$state" "$repo"
    fi
}

# ── Emit callback + shared helpers for frontend commands ──────────
# Emits one TAB-separated "owner/repo<TAB>path" per manifest entry.
do_emit() {
    local base_dir="$1" dir="$2" repo="$3"
    printf "%s\t%s/%s/%s\n" "$repo" "$base_dir" "$dir" "$(basename "$repo")"
}

# Emit only entries backed by a real clone. Broken paths (a directory that
# is not a git repo) are skipped so the frontend commands never treat one as
# a healthy repo; --status reports them explicitly instead.
emit_existing() {
    parse_conf do_emit | while IFS=$'\t' read -r r p; do
        if is_git_repo "$p"; then printf "%s\t%s\n" "$r" "$p"; fi
    done
}

# A clone, a worktree, or a submodule all have a .git entry; '-e' covers the
# directory and the file form. Deliberately not 'git rev-parse --git-dir',
# which walks up the tree and would report a parent repo's .git for a
# directory that is not itself a clone.
is_git_repo() {
    [[ -e "$1/.git" ]]
}

is_empty_dir() {
    local entries
    entries="$(ls -A "$1" 2>/dev/null)"
    [[ -z "$entries" ]]
}

# One 'git status --porcelain=v2 --branch' answers both questions we ask of a
# clone, so inspecting a repo costs a single git invocation.
#
# Sets, for the caller:
#   REPO_CHANGES  count of uncommitted changes (modified, unmerged, untracked)
#   REPO_AHEAD    commits not yet on the upstream branch
#   REPO_UPSTREAM true when an upstream is configured
#
# The '# branch.ab +N -M' header is absent when there is no upstream or HEAD
# is detached; the behind count M is deliberately ignored, since it is only as
# current as the last fetch. Use --outdated for a live answer.
REPO_CHANGES=0
REPO_AHEAD=0
REPO_UPSTREAM=false

inspect_repo() {
    local path="$1" line
    REPO_CHANGES=0
    REPO_AHEAD=0
    REPO_UPSTREAM=false

    while IFS= read -r line; do
        case "$line" in
            "# branch.ab "*)
                REPO_UPSTREAM=true
                local ab ahead
                ab="${line#\# branch.ab }"
                ahead="${ab%% *}"
                REPO_AHEAD="${ahead#+}"
                ;;
            "#"*) ;;
            *) REPO_CHANGES=$((REPO_CHANGES + 1)) ;;
        esac
    done < <(git -C "$path" status --porcelain=v2 --branch 2>/dev/null)
}

# ── Picker shared by --browse / --open ───────────────────────────
# Reads "label<TAB>path" lines on stdin, prints the chosen path to stdout.
# Uses fzf with preview if present, otherwise a numbered prompt.
pick_select() {
    local preview="$1"
    local lines
    lines="$(cat)"
    if [[ -z "$lines" ]]; then
        echo "[ERROR] No tracked, cloned repos in manifest." >&2
        return 1
    fi

    local selected=""
    if command -v fzf &>/dev/null; then
        selected="$(printf "%s\n" "$lines" \
            | fzf --delimiter=$'\t' --with-nth=1 \
                  --preview "$preview" \
                  --preview-window='right,60%,wrap')" || return 1
    else
        local -a arr=()
        while IFS= read -r _line; do
            arr+=("$_line")
        done <<< "$lines"
        local i=1
        for entry in "${arr[@]}"; do
            local label="${entry%%$'\t'*}"
            printf "  %d) %s\n" "$i" "$label" >&2
            i=$((i+1))
        done
        printf "  Choose [1-%d]: " "${#arr[@]}" >&2
        local n
        read -r n </dev/tty || return 1
        [[ -z "$n" ]] && return 1
        [[ "$n" =~ ^[0-9]+$ ]] || return 1
        (( n >= 1 && n <= ${#arr[@]} )) || return 1
        selected="${arr[$((n-1))]}"
    fi

    [[ -z "$selected" ]] && return 1
    printf "%s\n" "$selected" | cut -f2
}

# ── --browse ──────────────────────────────────────────────────────
browse_preview_cmd() {
    cat <<'EOF'
rrepo={1}
rpath={2}
echo "Repo:   $rrepo"
echo "Path:   $rpath"
echo "Remote: $(git -C "$rpath" remote get-url origin 2>/dev/null)"
echo
git_status=$(git -C "$rpath" status --porcelain 2>/dev/null)
if [ -n "$git_status" ]; then
    n=$(printf "%s\n" "$git_status" | wc -l | tr -d ' ')
    echo "Status: dirty ($n changes)"
    printf "%s\n" "$git_status" | head -5 | sed 's/^/  /'
else
    echo "Status: clean"
fi
echo
echo "Recent commits:"
git -C "$rpath" log --oneline -10 2>/dev/null
echo
if [ -f "$rpath/README.md" ]; then
    echo "README:"
    head -20 "$rpath/README.md"
fi
EOF
}

browse_repos() {
    if ! command -v fzf &>/dev/null; then
        echo "[WARN]  fzf not found; --browse degrades to a numbered list" >&2
    fi
    emit_existing | pick_select "$(browse_preview_cmd)"
}

# ── --where ───────────────────────────────────────────────────────
where_repo() {
    local target="$1" repo path
    local -a by_name=()

    # Exact owner/repo match wins; otherwise fall back to the repo name
    # (e.g. "intermcli" -> "pdbeard/intermcli"), but only if it is unique.
    while IFS=$'\t' read -r repo path; do
        if [[ "$repo" == "$target" ]]; then
            printf "%s\n" "$path"
            return 0
        fi
        [[ "${repo##*/}" == "$target" ]] && by_name+=("$path")
    done < <(parse_conf do_emit)

    if (( ${#by_name[@]} == 1 )); then
        printf "%s\n" "${by_name[0]}"
        return 0
    fi
    if (( ${#by_name[@]} > 1 )); then
        echo "[ERROR] '$target' matches several repos; use owner/repo:" >&2
        printf "  %s\n" "${by_name[@]}" >&2
        return 1
    fi
    echo "[ERROR] No manifest entry matches: $target" >&2
    return 1
}

# ── --recent ──────────────────────────────────────────────────────
recent_repos() {
    local n="$1"
    local author_filter=""
    if [[ "$RECENT_MINE" == true ]]; then
        author_filter="$(git config --global user.email 2>/dev/null \
            || git config user.email 2>/dev/null || true)"
        if [[ -z "$author_filter" ]]; then
            echo "[ERROR] --mine requires git user.email to be configured" >&2
            return 1
        fi
    fi

    emit_existing | while IFS=$'\t' read -r r p; do
        local ts
        if [[ -n "$author_filter" ]]; then
            ts="$(git -C "$p" log -1 --author="$author_filter" --format=%ct 2>/dev/null || true)"
        else
            ts="$(git -C "$p" log -1 --format=%ct 2>/dev/null || true)"
        fi
        [[ -z "$ts" ]] && ts=0
        printf "%s\t%s\n" "$ts" "$p"
    done | sort -rn | head -n "$n" | cut -f2
}

# ── --dirty ───────────────────────────────────────────────────────
dirty_repos() {
    emit_existing | while IFS=$'\t' read -r r p; do
        inspect_repo "$p"
        if (( REPO_CHANGES > 0 )); then printf "%s\n" "$p"; fi
    done
}

# ── --open ────────────────────────────────────────────────────────
open_repo() {
    local editor="$1"
    if [[ -z "$editor" ]]; then
        editor="${EDITOR:-}"
    fi
    if [[ -z "$editor" ]]; then
        for e in code vim; do
            if command -v "$e" &>/dev/null; then editor="$e"; break; fi
        done
    fi
    if [[ -z "$editor" ]]; then
        echo "[ERROR] No editor found (\$EDITOR unset, code/vim not on PATH)" >&2
        exit 1
    fi

    local path
    path="$(browse_repos)" || exit 1
    [[ -z "$path" ]] && exit 1
    # Unquoted on purpose: EDITOR often carries flags, e.g. "code --wait".
    # shellcheck disable=SC2086
    exec $editor "$path"
}

# ── --outdated ────────────────────────────────────────────────────
# Asks each remote whether it has commits we have not pulled.
#
# 'git fetch --dry-run' prints one line per ref that would be updated and
# nothing at all when up to date, so emptiness is the whole answer — no output
# parsing, and therefore no dependence on git's wording or the locale. It
# contacts the network but does not update refs, so --status stays unaffected.
outdated_repos() {
    local checked=0 behind=0 failed=0 skipped=0
    load_auth

    while IFS=$'\t' read -r repo path; do
        # Only the branch we actually track can be outdated. Without this the
        # check fetches every ref, so an untracked stale branch elsewhere in
        # the repo would report a pull the current branch does not need.
        #
        # The refspec must name a destination. A bare "refs/heads/x" fetches
        # into FETCH_HEAD unconditionally and so always prints a line; with
        # ":refs/remotes/<remote>/x" git compares against the tracking ref and
        # stays silent when there is nothing new.
        local upstream=""
        upstream="$(git -C "$path" rev-parse --abbrev-ref \
            --symbolic-full-name '@{upstream}' 2>/dev/null)" || upstream=""
        if [[ -z "$upstream" ]]; then
            skipped=$((skipped + 1))
            continue
        fi

        local remote="${upstream%%/*}"
        local branch="${upstream#*/}"
        checked=$((checked + 1))

        local out status=0
        out="$(git -C "$path" ${GIT_AUTH[@]+"${GIT_AUTH[@]}"} fetch --dry-run "$remote" \
            "refs/heads/$branch:refs/remotes/$remote/$branch" 2>&1)" || status=$?

        if (( status != 0 )); then
            echo "[ERROR] $repo: could not reach $remote" >&2
            failed=$((failed + 1))
            continue
        fi

        if [[ -n "$out" ]]; then
            printf "%s\n" "$path"
            behind=$((behind + 1))
        fi
    done < <(emit_existing)

    echo "" >&2
    printf "  checked: %d  needing pull: %d" "$checked" "$behind" >&2
    if (( skipped > 0 )); then printf "  no upstream: %d" "$skipped" >&2; fi
    if (( failed > 0 )); then printf "  unreachable: %d" "$failed" >&2; fi
    printf "\n" >&2
    if (( behind > 0 )); then
        echo "[HINT] Try: git-seed --outdated | xargs -I{} git -C {} pull" >&2
    fi
}

# ── Scout: insert helper ──────────────────────────────────────────
# Adds "$dir  $owner_repo" under the first [path] section that resolves to
# $search_dir, or appends a fresh section if there is none. Headers are read
# the way parse_conf reads them: comment and trailing space stripped, '~'
# expanded. The result is written back through the existing file, so a
# symlinked conf stays a symlink and keeps its permissions.
scout_insert_entry() {
    local search_dir="$1" dir="$2" owner_repo="$3"
    local tmp
    [[ -f "$CONF" ]] || : > "$CONF" || return 1
    tmp="$(mktemp)" || return 1

    if ! awk -v home="$HOME" -v want="$search_dir" -v entry="$dir  $owner_repo" \
             -v new_hdr="[path ${search_dir/#$HOME/\~}]" '
        {
            lines[NR] = $0
            l = $0; sub(/#.*/, "", l); sub(/[ \t]+$/, "", l)
        }
        l ~ /^\[path[ \t]+.+\]$/ {
            p = l; sub(/^\[path[ \t]+/, "", p); sub(/\]$/, "", p); sub(/^~/, home, p)
            in_section = (p == want && !header_line)
            if (in_section) header_line = NR
            next
        }
        in_section && l ~ /[^ \t]/ { last_entry_line = NR }
        END {
            insert_after = last_entry_line ? last_entry_line : header_line
            for (i = 1; i <= NR; i++) {
                print lines[i]
                if (i == insert_after) print entry
            }
            if (!insert_after) printf "\n%s\n%s\n", new_hdr, entry
        }
    ' "$CONF" > "$tmp"; then
        rm -f "$tmp"
        return 1
    fi

    if ! cat "$tmp" > "$CONF"; then
        echo "[ERROR] Could not write $CONF; updated copy kept at $tmp" >&2
        return 1
    fi
    rm -f "$tmp"
}

# ── Scout: collect untracked candidates ───────────────────────────
# Emits one TAB-separated row per candidate:
#   owner/repo<TAB>dir<TAB>search_dir<TAB>repo_path<TAB>remote
scout_collect_candidates() {
    declare -A search_paths
    get_conf_paths search_paths

    declare -A known
    if [[ -f "$CONF" ]]; then
        while IFS= read -r line; do
            local stripped="${line#\#}"
            stripped="${stripped#"${stripped%%[! ]*}"}"
            [[ "$stripped" =~ ^\[path ]] && continue
            # Commented-out entries still count as known, so scout does not
            # re-offer a repo the user deliberately disabled. Inline comments
            # are dropped so they don't end up inside the repo name.
            stripped="${stripped%%#*}"
            local label repo rest
            read -r label repo rest <<< "$stripped"
            repo="${repo%"${repo##*[![:space:]/]}"}"
            [[ -n "$repo" && "$repo" == */* ]] && known["$repo"]=1
        done < "$CONF"
    fi

    for search_dir in "${!search_paths[@]}"; do
        [[ ! -d "$search_dir" ]] && continue
        printf "[INFO] Scanning %s...\n" "${search_dir/#$HOME/\~}" >&2

        while IFS= read -r gitdir; do
            local repo_path="${gitdir%/.git}"
            local rel_path="${repo_path#"$search_dir"/}"

            # A repo directly in search_dir has no subdir label to file it under.
            [[ "$rel_path" != */* ]] && continue
            local dir="${rel_path%/*}" folder_name="${rel_path##*/}"

            # Only GitHub repos can be entries, since --sync clones from
            # github.com. Repo names may contain dots (user/site.github.io).
            local remote owner_repo
            remote=$(git -C "$repo_path" remote get-url origin 2>/dev/null || true)
            if [[ "$remote" =~ github\.com[:/]([^/]+/[^/]+)$ ]]; then
                owner_repo="${BASH_REMATCH[1]%.git}"
            else
                echo "[WARN]  Skipping ${repo_path/#$HOME/\~}: origin is not a GitHub repo" >&2
                continue
            fi

            [[ -n "${known[$owner_repo]:-}" ]] && continue

            # An entry resolves to <dir>/<repo name>. A clone in a folder with
            # another name would read as MISSING, and --sync would clone it again.
            if [[ "$folder_name" != "${owner_repo##*/}" ]]; then
                echo "[WARN]  Skipping ${repo_path/#$HOME/\~}: folder name differs from repo name '${owner_repo##*/}'" >&2
                continue
            fi

            printf "%s\t%s\t%s\t%s\t%s\n" \
                "$owner_repo" "$dir" "$search_dir" "$repo_path" "$remote"
        done < <(find "$search_dir" -name ".git" -type d -prune 2>/dev/null | sort)
    done
}

# ── Scout: dispatcher (fzf if present, else interactive prompt) ───
scout_repos() {
    local candidates
    candidates="$(scout_collect_candidates)"

    if [[ -z "$candidates" ]]; then
        echo "[OK] All repos are already tracked in repos.conf."
        return 0
    fi

    if command -v fzf &>/dev/null; then
        scout_fzf "$candidates"
    else
        scout_prompt "$candidates"
    fi
}

scout_fzf() {
    local candidates="$1"
    local total
    total="$(printf "%s\n" "$candidates" | wc -l | tr -d ' ')"
    echo "[INFO] Found $total untracked repo(s). TAB to multi-select, ENTER to add." >&2

    # Single quotes are deliberate: {1}..{5} are substituted by fzf, and the
    # shell variables below must be expanded by the preview subshell, not here.
    local preview
    # shellcheck disable=SC2016
    preview='
rrepo={1}
rdir={2}
rsec={3}
rpath={4}
echo "Repo:    $rrepo"
echo "Dir:     $rdir"
echo "Section: $rsec"
echo "Path:    $rpath"
echo "Remote:  {5}"
echo
echo "Recent commits:"
git -C "$rpath" log --oneline -5 2>/dev/null
echo
if [ -f "$rpath/README.md" ]; then
    echo "README:"
    head -15 "$rpath/README.md"
fi
'

    local selected
    if ! selected="$(printf "%s\n" "$candidates" \
        | fzf --multi --delimiter=$'\t' --with-nth=1,2 \
              --preview "$preview" --preview-window='right,60%,wrap' \
              --header='TAB: select  ENTER: add selected to repos.conf')"; then
        echo "[OK] No candidates selected."
        return 0
    fi
    [[ -z "$selected" ]] && { echo "[OK] No candidates selected."; return 0; }

    local added=0
    while IFS=$'\t' read -r owner_repo dir search_dir repo_path remote; do
        [[ -z "$owner_repo" ]] && continue
        if scout_insert_entry "$search_dir" "$dir" "$owner_repo"; then
            echo "[ADDED] $dir  $owner_repo"
            added=$((added + 1))
        else
            echo "[ERROR] Failed to add $owner_repo" >&2
        fi
    done <<< "$selected"

    echo ""
    if [[ "$added" -eq 0 ]]; then
        echo "[OK] $total untracked repo(s) found, none added."
    else
        echo "[DONE] Added $added of $total untracked repo(s) to repos.conf."
        echo "[HINT] Try: git-seed --browse"
    fi
}

scout_prompt() {
    local candidates="$1"
    local found=0 added=0

    while IFS=$'\t' read -r owner_repo dir search_dir repo_path remote; do
        found=$((found + 1))
        echo ""
        echo "  Found:  $owner_repo"
        echo "  Path:   $repo_path"
        [[ -n "$remote" ]] && echo "  Remote: $remote"

        printf "  Add to repos.conf under '%s'? [y/N] " "$dir"
        local answer; read -r answer </dev/tty
        [[ ! "$answer" =~ ^[Yy]$ ]] && continue

        if scout_insert_entry "$search_dir" "$dir" "$owner_repo"; then
            echo "  [ADDED] $dir  $owner_repo"
            added=$((added + 1))
        else
            echo "  [ERROR] Failed to update conf" >&2
        fi
    done <<< "$candidates"

    echo ""
    if [[ "$added" -eq 0 ]]; then
        echo "[OK] $found untracked repo(s) found, none added."
    else
        echo "[DONE] Added $added of $found untracked repo(s) to repos.conf."
        echo "[HINT] Try: git-seed --browse"
    fi
}

# ── List repos via gh ─────────────────────────────────────────────
list_repos() {
    if ! command -v gh &>/dev/null; then
        echo "[ERROR] 'gh' CLI required for --list. Run: gh auth login" >&2
        exit 1
    fi
    local limit=1000 repos
    repos="$(gh repo list --limit "$limit" --json nameWithOwner --jq '.[].nameWithOwner')"
    echo "# Paste into repos.conf:"
    [[ -n "$repos" ]] && awk -v dir="$LIST_DIR" '{ print dir "  " $0 }' <<< "$repos"
    if (( $(wc -l <<< "$repos") >= limit )); then
        echo "[WARN]  Stopped at $limit repos; some may be missing from this list" >&2
    fi
}

# ── Usage ─────────────────────────────────────────────────────────
usage() {
    cat <<EOF
Usage: git-seed <command> [options]

Manifest commands:
  --sync           Clone missing repos and pull existing ones (fast-forward
                   only). Exits 1 if any repo failed.
  --clone-only    Clone missing repos, skip existing
  --pull-only      Pull existing repos, skip missing
  --scout          Scan paths defined in conf for untracked git repos and
                   interactively offer to add them (multi-select fzf if present)
  --status         Show cloned/missing/dirty state for all repos in conf
  --list           List your GitHub repos via gh CLI (requires gh auth login)
                   Outputs lines ready to paste into repos.conf

Frontend commands:
  --browse         fzf picker with preview (commits, status, README).
                   Prints selected path on stdout.
  --where <repo>   Look up the local path for owner/repo (or basename).
                   Prints path on stdout.
  --recent [N]     List N most-recently-committed tracked repos (default 20).
                   One path per line.
  --mine           Modifier for --recent: only count commits by your
                   git user.email (shows repos you actively work in).
  --dirty          List tracked repos with uncommitted changes.
  --outdated       Check each remote for commits you have not pulled.
                   Requires network access. Prints one path per repo
                   that needs a pull; summary goes to stderr.
  --open [editor]  Run --browse, then open the selection in editor.
                   Editor defaults: \$EDITOR, then code, then vim.

Options:
  --dry-run        Print what would happen without making any changes
                   (works with --sync, --clone-only, --pull-only)
  --dir <label>    Directory label for --list output (default: projects)
  --conf FILE      Use a specific config file
  --base DIR       Fallback base dir for entries with no [path] section
                   (default: ~/git-seed-repos)
  --version        Print the version and exit
  --help           Show this message

Options only apply to the commands noted above; using one elsewhere is an
error rather than a silent no-op.

Composition examples:
  cd "\$(git-seed --browse)"
  \$EDITOR "\$(git-seed --where pdbeard/intermcli)"
  git-seed --dirty | xargs -I{} git -C {} status -s
  git-seed --recent 5

Config file lookup order:
  1. --conf FILE
  2. \$CONF_FILE
  3. ~/.config/git-seed/repos.conf  (or \$XDG_CONFIG_HOME/git-seed/repos.conf)
  4. <script dir>/repos.conf

Config format (repos.conf):
  [path ~/projects]
  personal      youruser/your-repo
  work          yourorg/their-repo

  [path ~/src]
  libs          someuser/a-library
EOF
}

# ── Main ──────────────────────────────────────────────────────────
[[ $# -eq 0 ]] && usage && exit 0

COMMAND=""
WHERE_REPO=""
RECENT_N=20
OPEN_EDITOR=""
DIR_SET=false

# Reject a second command rather than silently honouring the last one.
set_command() {
    if [[ -n "$COMMAND" && "$COMMAND" != "$1" ]]; then
        echo "[ERROR] Conflicting commands: --$COMMAND and --$1" >&2
        exit 1
    fi
    COMMAND="$1"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --sync)        set_command sync ;;
        --clone-only)  set_command clone-only ;;
        --pull-only)   set_command pull-only ;;
        --scout)       set_command scout ;;
        --status)      set_command status ;;
        --list)        set_command list ;;
        --browse)      set_command browse ;;
        --where)       [[ -z "${2:-}" || "${2:-}" == --* ]] && { echo "[ERROR] --where requires a repo argument" >&2; exit 1; }
                       set_command where; WHERE_REPO="$2"; shift ;;
        --where=*)     set_command where; WHERE_REPO="${1#--where=}"
                       [[ -z "$WHERE_REPO" ]] && { echo "[ERROR] --where requires a repo argument" >&2; exit 1; } ;;
        --recent)      set_command recent
                       if [[ -n "${2:-}" && "${2:-}" != --* ]]; then
                           [[ "$2" =~ ^[1-9][0-9]*$ ]] || { echo "[ERROR] --recent expects a positive integer, got: $2" >&2; exit 1; }
                           RECENT_N="$2"; shift
                       fi ;;
        --mine)        RECENT_MINE=true ;;
        --dirty)       set_command dirty ;;
        --outdated)    set_command outdated ;;
        --open)        set_command open
                       if [[ -n "${2:-}" && "${2:-}" != --* ]]; then
                           OPEN_EDITOR="$2"; shift
                       fi ;;
        --dry-run)     DRY_RUN=true ;;
        --dir)         [[ -z "${2:-}" || "${2:-}" == --* ]] && { echo "[ERROR] --dir requires a label argument" >&2; exit 1; }
                       LIST_DIR="$2"; DIR_SET=true; shift ;;
        --dir=*)       LIST_DIR="${1#--dir=}"; DIR_SET=true; [[ -z "$LIST_DIR" ]] && { echo "[ERROR] --dir requires a label argument" >&2; exit 1; } ;;
        --conf)        [[ -z "${2:-}" || "${2:-}" == --* ]] && { echo "[ERROR] --conf requires a file argument" >&2; exit 1; }
                       CONF="$2"; shift ;;
        --conf=*)      CONF="${1#--conf=}"; [[ -z "$CONF" ]] && { echo "[ERROR] --conf requires a file argument" >&2; exit 1; } ;;
        --base)        [[ -z "${2:-}" || "${2:-}" == --* ]] && { echo "[ERROR] --base requires a directory argument" >&2; exit 1; }
                       BASE_DIR="$2"; shift ;;
        --base=*)      BASE_DIR="${1#--base=}"; [[ -z "$BASE_DIR" ]] && { echo "[ERROR] --base requires a directory argument" >&2; exit 1; } ;;
        --version)     echo "git-seed $VERSION"; exit 0 ;;
        --help)        usage; exit 0 ;;
        *)             echo "[ERROR] Unknown option: $1" >&2; usage; exit 1 ;;
    esac
    shift
done

[[ -z "$COMMAND" ]] && usage && exit 0

# Reject flags that would otherwise be accepted and silently ignored.
if [[ "$RECENT_MINE" == true && "$COMMAND" != "recent" ]]; then
    echo "[ERROR] --mine only applies to --recent" >&2
    exit 1
fi
if [[ "$DIR_SET" == true && "$COMMAND" != "list" ]]; then
    echo "[ERROR] --dir only applies to --list" >&2
    exit 1
fi
if [[ "$DRY_RUN" == true ]]; then
    case "$COMMAND" in
        sync|clone-only|pull-only) ;;
        *) echo "[ERROR] --dry-run only applies to --sync, --clone-only and --pull-only" >&2
           exit 1 ;;
    esac
fi

case "$COMMAND" in
    sync)        run_sync ;;
    clone-only)  CLONE_ONLY=true;  run_sync ;;
    pull-only)   PULL_ONLY=true;   run_sync ;;
    scout)       scout_repos ;;
    status)      parse_conf do_status
                 echo ""
                 printf "  cloned: %d  missing: %d" "$STATUS_CLONED" "$STATUS_MISSING"
                 if [[ "$STATUS_BROKEN" -gt 0 ]]; then printf "  broken: %d" "$STATUS_BROKEN"; fi
                 printf "  dirty: %d  ahead: %d\n" "$STATUS_DIRTY" "$STATUS_AHEAD" ;;
    list)        list_repos ;;
    browse)      browse_repos ;;
    where)       where_repo "$WHERE_REPO" ;;
    recent)      recent_repos "$RECENT_N" ;;
    dirty)       dirty_repos ;;
    outdated)    outdated_repos ;;
    open)        open_repo "$OPEN_EDITOR" ;;
esac
