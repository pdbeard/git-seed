# git-seed config file
# Copy this file to ~/.config/git-seed/repos.conf, then edit it.
#
# Format:
#   [path ~/some/dir]       sets the base directory for the entries below it
#   <label>  <owner/repo>   an entry: clones to <base directory>/<label>/<repo>
#
# - A base directory must be an absolute path, or start with ~/
# - Entries above all [path] sections use --base (default: ~/git-seed-repos)
# - To disable an entry but keep it, put # at the start of its line
# - You can use more than one [path] section

[path ~/projects]
personal  youruser/repo-name
personal  youruser/another-repo
work      yourorg/some-repo

[path ~/src]
libs   someuser/a-library
tools  someuser/a-tool
